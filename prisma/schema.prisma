// Đợt 1: trung tâm, phòng, học sinh, phụ huynh, giáo viên/trợ giảng, lớp và lịch học.
// Ngày lưu dạng "YYYY-MM-DD", giờ dạng "HH:mm" (giờ Việt Nam) để tránh lệch múi giờ.
// Trạng thái lưu dạng chuỗi; danh sách giá trị hợp lệ nằm trong src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Center {
  id             Int                   @id @default(autoincrement())
  code           String                @unique
  name           String
  address        String?
  openHours      String?
  color          String                @default("#1F6FEB")
  rooms          Room[]
  students       Student[]
  availability   TeacherAvailability[]
  classes        ClassGroup[]
  teachers       TeacherCenter[]
  holidays       Holiday[]
  users          User[]
  payments       Payment[]
  refunds        Refund[]
  payrollPeriods PayrollPeriod[]
  expenses       Expense[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model Room {
  id        Int            @id @default(autoincrement())
  centerId  Int
  center    Center         @relation(fields: [centerId], references: [id])
  name      String
  capacity  Int            @default(12)
  equipment String?
  active    Boolean        @default(true)
  classes   ClassGroup[]
  sessions  ClassSession[]

  @@unique([centerId, name])
}

model Parent {
  id         Int               @id @default(autoincrement())
  fullName   String
  phone      String            @unique
  zalo       String?
  email      String?
  note       String?
  searchText String            @default("")
  children   StudentGuardian[]
  contacts   ContactLog[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Student {
  id              Int               @id @default(autoincrement())
  code            String            @unique
  fullName        String
  englishName     String?
  dob             String
  gender          String
  audience        String
  school          String?
  schoolGrade     String?
  centerId        Int
  center          Center            @relation(fields: [centerId], references: [id])
  level           String?
  status          String            @default("WAITING")
  statusReason    String?
  // Khóa học sinh đang chờ xếp lớp (M5: ghi danh chưa có lớp phù hợp).
  waitingCourseId Int?
  waitingCourse   Course?           @relation(fields: [waitingCourseId], references: [id])
  note            String?
  // Tên, tên tiếng Anh, mã, tên và SĐT phụ huynh, đã bỏ dấu, dùng cho tìm kiếm.
  searchText      String            @default("")
  guardians       StudentGuardian[]
  enrollments     ClassEnrollment[]
  attendances     Attendance[]
  makeups         Makeup[]
  reservations    Reservation[]
  contacts        ContactLog[]
  payments        Payment[]
  refunds         Refund[]
  scores          TestScore[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([centerId, status])
}

model StudentGuardian {
  id        Int     @id @default(autoincrement())
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  Int
  parent    Parent  @relation(fields: [parentId], references: [id])
  relation  String
  isPrimary Boolean @default(false)
  isPayer   Boolean @default(false)

  @@unique([studentId, parentId])
}

model Teacher {
  id             Int                   @id @default(autoincrement())
  code           String                @unique
  fullName       String
  displayName    String
  phone          String?
  email          String?
  role           String                @default("TEACHER")
  origin         String                @default("VN")
  employment     String                @default("PART_TIME")
  status         String                @default("ACTIVE")
  qualifications String?
  // Ngày hết hạn chứng chỉ giảng dạy (M8: cảnh báo trước 60 ngày).
  certExpiry     String?
  startDate      String?
  note           String?
  searchText     String                @default("")
  centers        TeacherCenter[]
  mainClasses    ClassGroup[]          @relation("MainTeacher")
  assistantIn    ClassAssistant[]
  sessions       ClassSession[]
  availability   TeacherAvailability[]
  leaves         TeacherLeave[]
  overlapPolicy  String                @default("SINGLE")
  overlapRatio   Float?                @default(1.5)
  rates          TeacherRate[]
  payrollPeriods PayrollPeriod[]
  user           User?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model TeacherCenter {
  teacherId Int
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  centerId  Int
  center    Center  @relation(fields: [centerId], references: [id])

  @@id([teacherId, centerId])
}

model Course {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  program        String?
  level          String?
  totalSessions  Int            @default(24)
  sessionMinutes Int            @default(90)
  tuition        Int            @default(0)
  maxStudents    Int            @default(12)
  // Khóa tiếp theo gợi ý khi học xong khóa này (tư vấn học tiếp, báo cáo tỷ lệ học tiếp).
  nextCourseId   Int?
  nextCourse     Course?        @relation("NextCourse", fields: [nextCourseId], references: [id])
  previous       Course[]       @relation("NextCourse")
  classes        ClassGroup[]
  waiting        Student[]
  lessons        CourseLesson[]
}

// Khung chương trình: bài của buổi số `index` trong khóa. Buổi số N của lớp tự lấy bài số N của khóa.
model CourseLesson {
  id         Int     @id @default(autoincrement())
  courseId   Int
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  index      Int
  title      String
  objectives String?
  content    String?
  homework   String?
  // JSON: [{ "name": "Slide Unit 1", "url": "https://…" }]
  materials  String  @default("[]")
  // Loại kiểm tra (src/lib/curriculum.ts): trống = buổi thường, QUIZ, MIDTERM, FINAL.
  testKind   String?

  @@unique([courseId, index])
}

model ClassGroup {
  id            Int               @id @default(autoincrement())
  code          String            @unique
  name          String
  courseId      Int?
  course        Course?           @relation(fields: [courseId], references: [id])
  centerId      Int
  center        Center            @relation(fields: [centerId], references: [id])
  roomId        Int
  room          Room              @relation(fields: [roomId], references: [id])
  teacherId     Int
  teacher       Teacher           @relation("MainTeacher", fields: [teacherId], references: [id])
  status        String            @default("PLANNED")
  // Thứ trong tuần, 1 = Thứ 2 … 7 = Chủ nhật, cách nhau bởi dấu phẩy. Ví dụ "1,3,5".
  weekdays      String
  startTime     String
  endTime       String
  startDate     String
  totalSessions Int
  maxStudents   Int               @default(12)
  note          String?
  assistants    ClassAssistant[]
  sessions      ClassSession[]
  enrollments   ClassEnrollment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ClassAssistant {
  classId   Int
  class     ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId Int
  teacher   Teacher    @relation(fields: [teacherId], references: [id])

  @@id([classId, teacherId])
}

model ClassSession {
  id                Int          @id @default(autoincrement())
  classId           Int
  class             ClassGroup   @relation(fields: [classId], references: [id], onDelete: Cascade)
  index             Int
  date              String
  startTime         String
  endTime           String
  roomId            Int
  room              Room         @relation(fields: [roomId], references: [id])
  // Người dạy thực tế của buổi (mặc định là giáo viên chính, đổi khi dạy thay).
  teacherId         Int
  teacher           Teacher      @relation(fields: [teacherId], references: [id])
  status            String       @default("SCHEDULED")
  note              String?
  // Một dòng nội dung đã dạy, giáo viên ghi khi điểm danh.
  lessonContent     String?
  // Lần điểm danh gần nhất; trống = chưa điểm danh.
  attendanceTakenAt DateTime?
  attendanceBy      String?
  attendances       Attendance[]
  makeups           Makeup[]
  scores            TestScore[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([date])
  @@index([classId, index])
}

model ClassEnrollment {
  id                Int              @id @default(autoincrement())
  classId           Int
  class             ClassGroup       @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId         Int
  student           Student          @relation(fields: [studentId], references: [id])
  joinedAt          String
  leftAt            String?
  // Số buổi đã mua; trống = theo số buổi của lớp (dữ liệu cũ trước khi có trường này).
  purchasedSessions Int?
  // Cộng / trừ tay (tặng buổi, chuyển buổi từ khóa trước…), kèm lý do.
  adjustment        Int              @default(0)
  adjustmentNote    String?
  // Ghi danh cũ khi học sinh được chuyển sang lớp này (số buổi còn lại chuyển theo).
  transferredFromId Int?             @unique
  transferredFrom   ClassEnrollment? @relation("Transfer", fields: [transferredFromId], references: [id])
  transferredTo     ClassEnrollment? @relation("Transfer")
  // Kết quả cuối khóa (src/lib/history.ts) và nhận xét tổng kết của giáo viên, gửi phụ huynh.
  outcome           String?
  finalComment      String?
  outcomeBy         String?
  outcomeAt         DateTime?
  tuitionFee        Int?
  discountType      String?
  discountMode      String?
  discountValue     Int?
  dueDate           String?
  attendances       Attendance[]
  payments          Payment[]
  refunds           Refund[]
  scores            TestScore[]

  @@index([studentId])
  @@index([classId])
}

model Holiday {
  id       Int     @id @default(autoincrement())
  date     String
  name     String
  // Trống = nghỉ chung cả 4 trung tâm.
  centerId Int?
  center   Center? @relation(fields: [centerId], references: [id])

  @@index([date])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  entity    String
  entityId  Int
  action    String
  // JSON: { field: [cũ, mới] }
  changes   String
  actor     String   @default("Hệ thống")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// Tài khoản đăng nhập. Vai trò: MANAGER, OFFICE (giáo vụ, gắn 1 trung tâm),
// TEACHER, ASSISTANT (gắn hồ sơ giáo viên). Danh sách nằm trong src/lib/permissions.ts.
model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  fullName     String
  passwordHash String
  role         String
  centerId     Int?
  center       Center?       @relation(fields: [centerId], references: [id])
  teacherId    Int?          @unique
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])
  active       Boolean       @default(true)
  lastLoginAt  DateTime?
  sessions     UserSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Phiên đăng nhập. Cookie giữ mã ngẫu nhiên, DB chỉ lưu mã băm SHA-256 của nó.
model UserSession {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Điểm danh một học sinh trong một buổi. Trạng thái: PRESENT, LATE, EXCUSED, UNEXCUSED
// (src/lib/attendance.ts). Buổi trừ vào ghi danh `enrollmentId`; học bù trừ vào ghi danh của buổi vắng gốc.
model Attendance {
  id           Int             @id @default(autoincrement())
  sessionId    Int
  session      ClassSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student         @relation(fields: [studentId], references: [id])
  enrollmentId Int
  enrollment   ClassEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status       String
  comment      String?
  // Có giá trị khi đây là buổi học bù: buổi vắng gốc được bù.
  makeupId     Int?            @unique
  makeup       Makeup?         @relation("MakeupAttendance", fields: [makeupId], references: [id])
  makeupFor    Makeup?         @relation("MakeupSource")
  takenBy      String
  updatedAt    DateTime        @updatedAt

  @@unique([sessionId, studentId])
  @@index([enrollmentId])
  @@index([studentId])
}

// Xếp học bù: buổi vắng `absenceId` được bù ở buổi `sessionId` (thường của lớp khác cùng khóa).
model Makeup {
  id         Int          @id @default(autoincrement())
  absenceId  Int          @unique
  absence    Attendance   @relation("MakeupSource", fields: [absenceId], references: [id], onDelete: Cascade)
  sessionId  Int
  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  Int
  student    Student      @relation(fields: [studentId], references: [id])
  attendance Attendance?  @relation("MakeupAttendance")
  createdBy  String
  createdAt  DateTime     @default(now())

  @@index([sessionId])
}

// Lịch rảnh hằng tuần của giáo viên / trợ giảng: một dòng = một khung giờ trong một thứ.
// Trống trung tâm = rảnh ở mọi trung tâm mình dạy.
model TeacherAvailability {
  id        Int     @id @default(autoincrement())
  teacherId Int
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // 1 = Thứ 2 … 7 = Chủ nhật
  weekday   Int
  startTime String
  endTime   String
  centerId  Int?
  center    Center? @relation(fields: [centerId], references: [id])

  @@index([teacherId])
}

// Ngày nghỉ của giáo viên / trợ giảng (từ ngày → đến ngày, tính cả hai đầu). Không có bước duyệt.
model TeacherLeave {
  id        Int      @id @default(autoincrement())
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  fromDate  String
  toDate    String
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  @@index([teacherId, fromDate])
}

// Bảo lưu: học sinh tạm dừng từ `startDate`, dự kiến quay lại `expectedReturn`.
// `returnedAt` có giá trị khi đã học lại. Trong thời gian bảo lưu học sinh không có trong danh sách
// điểm danh nên số buổi còn lại được giữ nguyên.
model Reservation {
  id             Int      @id @default(autoincrement())
  studentId      Int
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startDate      String
  expectedReturn String
  returnedAt     String?
  reason         String?
  createdBy      String
  createdAt      DateTime @default(now())

  @@index([studentId])
}

// Nhật ký liên lạc với phụ huynh về một học sinh (gọi, Zalo, gặp trực tiếp…).
// Có `followUpDate` mà chưa có `followUpDoneAt` = việc cần gọi lại (M7).
model ContactLog {
  id             Int       @id @default(autoincrement())
  studentId      Int
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId       Int?
  parent         Parent?   @relation(fields: [parentId], references: [id])
  channel        String
  content        String
  followUpDate   String?
  followUpNote   String?
  followUpDoneAt DateTime?
  followUpDoneBy String?
  createdBy      String
  createdAt      DateTime  @default(now())

  @@index([studentId])
  @@index([followUpDate])
}

// Phiếu thu học phí (Tổng quan yêu cầu mục 3.7). Không được xóa, chỉ hủy kèm lý do.
model Payment {
  id           Int             @id @default(autoincrement())
  code         String          @unique
  enrollmentId Int
  enrollment   ClassEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student         @relation(fields: [studentId], references: [id])
  centerId     Int
  center       Center          @relation(fields: [centerId], references: [id])
  amount       Int
  date         String
  method       String          @default("CASH")
  status       String          @default("VALID")
  cancelReason String?
  cancelledAt  DateTime?
  cancelledBy  String?
  note         String?
  createdBy    String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([enrollmentId])
  @@index([studentId])
  @@index([centerId, date])
}

// Hoàn tiền học phí (Tổng quan yêu cầu mục 3.7). Chỉ Quản lý duyệt.
model Refund {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  enrollmentId   Int
  enrollment     ClassEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student         @relation(fields: [studentId], references: [id])
  centerId       Int
  center         Center          @relation(fields: [centerId], references: [id])
  amount         Int
  date           String
  reason         String
  unusedSessions Int?
  status         String          @default("VALID")
  cancelReason   String?
  cancelledAt    DateTime?
  cancelledBy    String?
  approvedBy     String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([enrollmentId])
  @@index([studentId])
  @@index([centerId, date])
}

// Đơn giá giờ dạy theo từng người, riêng cho vai trò giáo viên và trợ giảng.
model TeacherRate {
  id            Int      @id @default(autoincrement())
  teacherId     Int
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  role          String   @default("TEACHER")
  hourlyRate    Int      @default(0)
  effectiveDate String
  note          String?
  createdAt     DateTime @default(now())

  @@index([teacherId, role])
}

// Bảng lương tháng của giáo viên / trợ giảng (Tổng quan yêu cầu mục 3.7).
model PayrollPeriod {
  id           Int                 @id @default(autoincrement())
  month        String
  teacherId    Int
  teacher      Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  centerId     Int?
  center       Center?             @relation(fields: [centerId], references: [id])
  status       String              @default("DRAFT")
  totalHours   Float               @default(0)
  teachingPay  Int                 @default(0)
  bonusPay     Int                 @default(0)
  allowancePay Int                 @default(0)
  penaltyPay   Int                 @default(0)
  finalPay     Int                 @default(0)
  lockedAt     DateTime?
  lockedBy     String?
  paidAt       DateTime?
  paidBy       String?
  note         String?
  adjustments  PayrollAdjustment[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([month, teacherId])
  @@index([month])
}

// Dòng điều chỉnh trong bảng lương tháng: thưởng, phụ cấp, phạt.
model PayrollAdjustment {
  id              Int           @id @default(autoincrement())
  payrollPeriodId Int
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  type            String
  amount          Int
  note            String
  createdBy       String
  createdAt       DateTime      @default(now())

  @@index([payrollPeriodId])
}

// Chi phí hoạt động của trung tâm (Tổng quan yêu cầu mục 3.7).
model Expense {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  centerId  Int
  center    Center   @relation(fields: [centerId], references: [id])
  category  String
  amount    Int
  date      String
  payer     String
  note      String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId, date])
  @@index([category])
}

// Điểm kiểm tra theo kỹ năng của một học sinh ở một buổi (Tổng quan yêu cầu mục 3.6).
// Thang 10; trống = không kiểm tra kỹ năng đó. `total` trống thì lấy trung bình các kỹ năng đã nhập.
model TestScore {
  id           Int             @id @default(autoincrement())
  sessionId    Int
  session      ClassSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student         @relation(fields: [studentId], references: [id])
  enrollmentId Int
  enrollment   ClassEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  // QUIZ, MIDTERM, FINAL (src/lib/curriculum.ts)
  kind         String          @default("QUIZ")
  listening    Float?
  speaking     Float?
  reading      Float?
  writing      Float?
  total        Float?
  note         String?
  enteredBy    String
  updatedAt    DateTime        @updatedAt

  @@unique([sessionId, studentId])
  @@index([enrollmentId])
}
