// Đợt 1: trung tâm, phòng, học sinh, phụ huynh, giáo viên/trợ giảng, lớp và lịch học.
// Ngày lưu dạng "YYYY-MM-DD", giờ dạng "HH:mm" (giờ Việt Nam) để tránh lệch múi giờ.
// Trạng thái lưu dạng chuỗi; danh sách giá trị hợp lệ nằm trong src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Center {
  id           Int                   @id @default(autoincrement())
  code         String                @unique
  name         String
  address      String?
  openHours    String?
  color        String                @default("#1F6FEB")
  rooms        Room[]
  students     Student[]
  availability TeacherAvailability[]
  classes      ClassGroup[]
  teachers     TeacherCenter[]
  holidays     Holiday[]
  users        User[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model Room {
  id        Int            @id @default(autoincrement())
  centerId  Int
  center    Center         @relation(fields: [centerId], references: [id])
  name      String
  capacity  Int            @default(12)
  equipment String?
  active    Boolean        @default(true)
  classes   ClassGroup[]
  sessions  ClassSession[]

  @@unique([centerId, name])
}

model Parent {
  id         Int               @id @default(autoincrement())
  fullName   String
  phone      String            @unique
  zalo       String?
  email      String?
  note       String?
  searchText String            @default("")
  children   StudentGuardian[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Student {
  id           Int               @id @default(autoincrement())
  code         String            @unique
  fullName     String
  englishName  String?
  dob          String
  gender       String
  audience     String
  school       String?
  schoolGrade  String?
  centerId     Int
  center       Center            @relation(fields: [centerId], references: [id])
  level        String?
  status       String            @default("WAITING")
  statusReason String?
  note         String?
  // Tên, tên tiếng Anh, mã, tên và SĐT phụ huynh, đã bỏ dấu, dùng cho tìm kiếm.
  searchText   String            @default("")
  guardians    StudentGuardian[]
  enrollments  ClassEnrollment[]
  attendances  Attendance[]
  makeups      Makeup[]
  reservations Reservation[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([centerId, status])
}

model StudentGuardian {
  id        Int     @id @default(autoincrement())
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  Int
  parent    Parent  @relation(fields: [parentId], references: [id])
  relation  String
  isPrimary Boolean @default(false)
  isPayer   Boolean @default(false)

  @@unique([studentId, parentId])
}

model Teacher {
  id             Int                   @id @default(autoincrement())
  code           String                @unique
  fullName       String
  displayName    String
  phone          String?
  email          String?
  role           String                @default("TEACHER")
  origin         String                @default("VN")
  employment     String                @default("PART_TIME")
  status         String                @default("ACTIVE")
  qualifications String?
  startDate      String?
  note           String?
  searchText     String                @default("")
  centers        TeacherCenter[]
  mainClasses    ClassGroup[]          @relation("MainTeacher")
  assistantIn    ClassAssistant[]
  sessions       ClassSession[]
  availability   TeacherAvailability[]
  leaves         TeacherLeave[]
  user           User?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model TeacherCenter {
  teacherId Int
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  centerId  Int
  center    Center  @relation(fields: [centerId], references: [id])

  @@id([teacherId, centerId])
}

model Course {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  program        String?
  level          String?
  totalSessions  Int          @default(24)
  sessionMinutes Int          @default(90)
  tuition        Int          @default(0)
  maxStudents    Int          @default(12)
  classes        ClassGroup[]
}

model ClassGroup {
  id            Int               @id @default(autoincrement())
  code          String            @unique
  name          String
  courseId      Int?
  course        Course?           @relation(fields: [courseId], references: [id])
  centerId      Int
  center        Center            @relation(fields: [centerId], references: [id])
  roomId        Int
  room          Room              @relation(fields: [roomId], references: [id])
  teacherId     Int
  teacher       Teacher           @relation("MainTeacher", fields: [teacherId], references: [id])
  status        String            @default("PLANNED")
  // Thứ trong tuần, 1 = Thứ 2 … 7 = Chủ nhật, cách nhau bởi dấu phẩy. Ví dụ "1,3,5".
  weekdays      String
  startTime     String
  endTime       String
  startDate     String
  totalSessions Int
  maxStudents   Int               @default(12)
  note          String?
  assistants    ClassAssistant[]
  sessions      ClassSession[]
  enrollments   ClassEnrollment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ClassAssistant {
  classId   Int
  class     ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId Int
  teacher   Teacher    @relation(fields: [teacherId], references: [id])

  @@id([classId, teacherId])
}

model ClassSession {
  id                Int          @id @default(autoincrement())
  classId           Int
  class             ClassGroup   @relation(fields: [classId], references: [id], onDelete: Cascade)
  index             Int
  date              String
  startTime         String
  endTime           String
  roomId            Int
  room              Room         @relation(fields: [roomId], references: [id])
  // Người dạy thực tế của buổi (mặc định là giáo viên chính, đổi khi dạy thay).
  teacherId         Int
  teacher           Teacher      @relation(fields: [teacherId], references: [id])
  status            String       @default("SCHEDULED")
  note              String?
  // Một dòng nội dung đã dạy, giáo viên ghi khi điểm danh.
  lessonContent     String?
  // Lần điểm danh gần nhất; trống = chưa điểm danh.
  attendanceTakenAt DateTime?
  attendanceBy      String?
  attendances       Attendance[]
  makeups           Makeup[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([date])
  @@index([classId, index])
}

model ClassEnrollment {
  id                Int              @id @default(autoincrement())
  classId           Int
  class             ClassGroup       @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId         Int
  student           Student          @relation(fields: [studentId], references: [id])
  joinedAt          String
  leftAt            String?
  // Số buổi đã mua; trống = theo số buổi của lớp (dữ liệu cũ trước khi có trường này).
  purchasedSessions Int?
  // Cộng / trừ tay (tặng buổi, chuyển buổi từ khóa trước…), kèm lý do.
  adjustment        Int              @default(0)
  adjustmentNote    String?
  // Ghi danh cũ khi học sinh được chuyển sang lớp này (số buổi còn lại chuyển theo).
  transferredFromId Int?             @unique
  transferredFrom   ClassEnrollment? @relation("Transfer", fields: [transferredFromId], references: [id])
  transferredTo     ClassEnrollment? @relation("Transfer")
  attendances       Attendance[]

  @@index([studentId])
  @@index([classId])
}

model Holiday {
  id       Int     @id @default(autoincrement())
  date     String
  name     String
  // Trống = nghỉ chung cả 4 trung tâm.
  centerId Int?
  center   Center? @relation(fields: [centerId], references: [id])

  @@index([date])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  entity    String
  entityId  Int
  action    String
  // JSON: { field: [cũ, mới] }
  changes   String
  actor     String   @default("Hệ thống")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// Tài khoản đăng nhập. Vai trò: MANAGER, OFFICE (giáo vụ, gắn 1 trung tâm),
// TEACHER, ASSISTANT (gắn hồ sơ giáo viên). Danh sách nằm trong src/lib/permissions.ts.
model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  fullName     String
  passwordHash String
  role         String
  centerId     Int?
  center       Center?       @relation(fields: [centerId], references: [id])
  teacherId    Int?          @unique
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])
  active       Boolean       @default(true)
  lastLoginAt  DateTime?
  sessions     UserSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Phiên đăng nhập. Cookie giữ mã ngẫu nhiên, DB chỉ lưu mã băm SHA-256 của nó.
model UserSession {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Điểm danh một học sinh trong một buổi. Trạng thái: PRESENT, LATE, EXCUSED, UNEXCUSED
// (src/lib/attendance.ts). Buổi trừ vào ghi danh `enrollmentId`; học bù trừ vào ghi danh của buổi vắng gốc.
model Attendance {
  id           Int             @id @default(autoincrement())
  sessionId    Int
  session      ClassSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student         @relation(fields: [studentId], references: [id])
  enrollmentId Int
  enrollment   ClassEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status       String
  comment      String?
  // Có giá trị khi đây là buổi học bù: buổi vắng gốc được bù.
  makeupId     Int?            @unique
  makeup       Makeup?         @relation("MakeupAttendance", fields: [makeupId], references: [id])
  makeupFor    Makeup?         @relation("MakeupSource")
  takenBy      String
  updatedAt    DateTime        @updatedAt

  @@unique([sessionId, studentId])
  @@index([enrollmentId])
  @@index([studentId])
}

// Xếp học bù: buổi vắng `absenceId` được bù ở buổi `sessionId` (thường của lớp khác cùng khóa).
model Makeup {
  id         Int          @id @default(autoincrement())
  absenceId  Int          @unique
  absence    Attendance   @relation("MakeupSource", fields: [absenceId], references: [id], onDelete: Cascade)
  sessionId  Int
  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  Int
  student    Student      @relation(fields: [studentId], references: [id])
  attendance Attendance?  @relation("MakeupAttendance")
  createdBy  String
  createdAt  DateTime     @default(now())

  @@index([sessionId])
}

// Lịch rảnh hằng tuần của giáo viên / trợ giảng: một dòng = một khung giờ trong một thứ.
// Trống trung tâm = rảnh ở mọi trung tâm mình dạy.
model TeacherAvailability {
  id        Int     @id @default(autoincrement())
  teacherId Int
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // 1 = Thứ 2 … 7 = Chủ nhật
  weekday   Int
  startTime String
  endTime   String
  centerId  Int?
  center    Center? @relation(fields: [centerId], references: [id])

  @@index([teacherId])
}

// Ngày nghỉ của giáo viên / trợ giảng (từ ngày → đến ngày, tính cả hai đầu). Không có bước duyệt.
model TeacherLeave {
  id        Int      @id @default(autoincrement())
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  fromDate  String
  toDate    String
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  @@index([teacherId, fromDate])
}

// Bảo lưu: học sinh tạm dừng từ `startDate`, dự kiến quay lại `expectedReturn`.
// `returnedAt` có giá trị khi đã học lại. Trong thời gian bảo lưu học sinh không có trong danh sách
// điểm danh nên số buổi còn lại được giữ nguyên.
model Reservation {
  id             Int      @id @default(autoincrement())
  studentId      Int
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startDate      String
  expectedReturn String
  returnedAt     String?
  reason         String?
  createdBy      String
  createdAt      DateTime @default(now())

  @@index([studentId])
}
